#!/usr/bin/env bash
# forge — single-entrypoint dispatcher for forge exec layer
#
# USAGE: forge <verb> [args...]
#
# VERBS:
#   init                       Initialize .forge/ workspace
#   status                     Display active feature status dashboard
#   slice                      Print active-feature-only projection (hot read, <1k tokens)
#   merge   <feat> <phase> <output-json>  Merge phase output into state index
#   save    <state-file>       Atomic save of state JSON (stdin → state-file)
#   mark-complete <feat> <phase> <status> [--summary "..."]
#                              Mark phase complete, write bulk NN.json, update thin index
#   invalidate-downstream <feat> <phase>  Invalidate phases after <phase>
#   repair  [<state-file>]     Scan index for dangling refs + orphan NN.json files
#   ref     <feat> <name> [--print]  Deref a ref envelope (prints locator or content)
#   archive <slug>             Move terminal feature bulk → archive.json, leave stub
#   ghost-snapshot <slug>      Snapshot project working tree → forge-ghost/<slug> branch
#   ghost-diff <slug> <sha1> <sha2>  Diff between two ghost SHAs in project repo
#   ghost-guard install        Install pre-push hook refusing forge-ghost/* refs
#   commit-phase <slug> <N> <status> [--log-line "..."] [--carry "..."] [--ghost-sha <sha>]
#                              Commit phase to .forge git (replaces FORGE-LOGS.md)
#   log-query [--feature <slug>] [--phase N]  Reconstruct audit from .forge git log
#   rollback <slug> <N> [--tree-restore]  Rollback forge state to phase N
#   metadata set <slug> <phase> "<note>"  Attach optional note to phase (stored in NN.json bulk)
#   metadata get <slug> [--todos]         Retrieve notes across feature phases
#   metadata migrate-learnings [--state <f>]  Move learnings from state.json → learnings.json
#   autowrite-phase <slug> <phase>        Convenience: merge+mark-complete+commit-phase in one
#
# OUTPUT:
#   --json   Emit structured JSON on stdout (default: human-readable text)
#   Non-zero exit + message to stderr on all errors.
#
# ENTRYPOINT CONTRACT (BLK-2):
#   SKILL.md calls: $(dirname <SKILL.md>)/bin/forge <verb>
#   All deterministic state ops MUST go through this dispatcher.
#   Workers NEVER touch state.json directly.
#
# STATE FILE LOCATION:
#   Resolved as: ${FORGE_STATE:-<project_root>/.forge/state.json}
#   Project root = first ancestor dir containing .forge/, or $PWD.
#
# WRITE ORDER (BLK-3):
#   Phase bulk written to features/<slug>/phases/NN.json FIRST,
#   then atomic index update (temp+rename) in state.json.
#   Startup repair detects partial writes and marks incomplete.

set -euo pipefail

FORGE_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FORGE_LIB_DIR="${FORGE_BIN_DIR}/lib"

# ── output mode ─────────────────────────────────────────────────────────────
JSON_MODE=0
args=()
for arg in "$@"; do
  if [[ "$arg" == "--json" ]]; then
    JSON_MODE=1
  else
    args+=("$arg")
  fi
done
if [[ ${#args[@]} -gt 0 ]]; then set -- "${args[@]}"; else set --; fi

export FORGE_JSON_MODE="$JSON_MODE"

# ── helpers ──────────────────────────────────────────────────────────────────
forge_error() {
  local msg="$1"
  if [[ "$JSON_MODE" -eq 1 ]]; then
    printf '{"ok":false,"error":"%s"}\n' "$msg" >&2
  else
    printf 'forge: error: %s\n' "$msg" >&2
  fi
  exit 1
}

# ── find project root (first ancestor with .forge/) ──────────────────────────
find_project_root() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    if [[ -d "$dir/.forge" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  # fallback: cwd (init will create .forge/)
  echo "$PWD"
}

export FORGE_PROJECT_ROOT="${FORGE_PROJECT_ROOT:-$(find_project_root)}"

# FORGE_DIR: when FORGE_STATE is explicitly set (test isolation), derive FORGE_DIR
# from it so all bulk writes target the same directory as the override state file.
# Otherwise fall back to project-root default.
if [[ -n "${FORGE_STATE+x}" ]]; then
  export FORGE_DIR="${FORGE_STATE%/state.json}"
else
  export FORGE_DIR="${FORGE_PROJECT_ROOT}/.forge"
  export FORGE_STATE="${FORGE_DIR}/state.json"
fi

# ── dispatch ─────────────────────────────────────────────────────────────────
if [[ $# -lt 1 ]]; then
  forge_error "no verb given. Usage: forge <verb> [args...]"
fi

verb="$1"
shift

case "$verb" in
  init|status|slice|merge|save|mark-complete|invalidate-downstream|repair)
    exec "${FORGE_LIB_DIR}/state.sh" "$verb" "$@"
    ;;
  ref)
    exec "${FORGE_LIB_DIR}/ref.sh" "$verb" "$@"
    ;;
  archive)
    exec "${FORGE_LIB_DIR}/archive.sh" "$verb" "$@"
    ;;
  ghost-snapshot|ghost-diff|ghost-guard)
    exec "${FORGE_LIB_DIR}/ghost.sh" "$verb" "$@"
    ;;
  commit-phase|log-query)
    exec "${FORGE_LIB_DIR}/commit.sh" "$verb" "$@"
    ;;
  rollback)
    exec "${FORGE_LIB_DIR}/rollback.sh" "$verb" "$@"
    ;;
  metadata)
    exec "${FORGE_LIB_DIR}/metadata.sh" "$verb" "$@"
    ;;
  autowrite-phase)
    exec "${FORGE_LIB_DIR}/autowrite.sh" "$verb" "$@"
    ;;
  cascade-fix)
    exec "${FORGE_LIB_DIR}/cascade.sh" "$verb" "$@"
    ;;
  resume)
    exec "${FORGE_LIB_DIR}/resume.sh" "$@"
    ;;
  *)
    forge_error "unknown verb '${verb}'. Valid verbs: init status slice merge save mark-complete invalidate-downstream repair ref archive ghost-snapshot ghost-diff ghost-guard commit-phase log-query rollback metadata autowrite-phase cascade-fix resume"
    ;;
esac
